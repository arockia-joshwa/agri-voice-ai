# AgriVoice AI - Environment Configuration

# Application Mode: 'demo' (built-in agricultural AI & vision simulation) or 'production' (PyTorch CNN & Live LLM)
AI_MODE=demo

# Server Port
PORT=8000
HOST=0.0.0.0

# Optional: Google Gemini API Key for dynamic Tamil conversational LLM
# If left empty, AgriVoice AI uses its built-in context-aware Agricultural Expert Engine
GEMINI_API_KEY=

# Optional: Path to custom trained PyTorch CNN weights (.pth / TorchScript)
# Example: ml/models/crop_cnn_best.pth
CNN_MODEL_PATH=C:\final agri voice ai\agrivoice-ai

# Database
DATABASE_URL=sqlite:///./backend/data/agrivoice.db
